# VS Code auto-forwards detected dev-server ports and binds 127.0.0.1 for them.
# A wildcard bind (0.0.0.0) does not win that address on Windows, so the dev
# server would start without complaint while localhost served VS Code's file
# browser instead. Binding the loopback address directly claims it first, and
# any future clash fails loudly with EADDRINUSE rather than silently.
HOST=127.0.0.1

# 3000 and 3001 are currently held by stale VS Code forwards. See
# .vscode/settings.json, which stops new ones being created.
PORT=3002

# The API. Keep this in sync with CORS_ORIGINS on the backend.
REACT_APP_API_URL=http://localhost:8000
